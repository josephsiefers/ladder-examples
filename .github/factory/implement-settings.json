{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Skill",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git stash *)",
      "Bash(ls)",
      "Bash(ls *)"
    ],
    "deny": [
      "Read(./.envrc)",
      "Edit(./.envrc)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify *)",
      "Bash(git commit * --no-verify)",
      "Bash(git push *)",
      "Bash(gh *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-context.ts\" --once-per-session"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-context.ts\" --once-per-session"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "deep-research": "off",
    "design": "off",
    "design-sync": "off",
    "dataviz": "off",
    "update-config": "off",
    "verify": "off",
    "debug": "off",
    "code-review": "off",
    "simplify": "off",
    "batch": "off",
    "fewer-permission-prompts": "off",
    "doctor": "off",
    "loop": "off",
    "schedule": "off",
    "claude-api": "off",
    "workflow-authoring": "off",
    "run": "off",
    "run-skill-generator": "off",
    "plugin-authoring": "off"
  }
}
